{
  "name": "advent-code-2023-wasm-rust",
  "version": "1.0.0",
  "description": "A front end web app that uses rust wasm to present solutions to advent of code 2023.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build-js": "rollup -c",
    "prettier": "prettier . --config ./.prettierrc.json --write",
    "server": "servez --port=23523 dist",
    "build-rust": "wasm-pack build --target web",
    "format-rust": "cargo fmt -v",
    "test-rust": "cargo test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mazchoo/AdventOfCode2023.git"
  },
  "keywords": [
    "rust",
    "wasm",
    "typescript",
    "advent-of-code",
    "2023"
  ],
  "author": "Matthew Mitchell",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Mazchoo/AdventOfCode2023/issues"
  },
  "homepage": "https://github.com/Mazchoo/AdventOfCode2023#readme",
  "dependencies": {
    "showdown": "^2.1.0"
  },
  "devDependencies": {
    "@babel/runtime": "^7.24.7",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@rollup/plugin-wasm": "^6.2.2",
    "@tsconfig/recommended": "^1.0.8",
    "glob": "^11.0.0",
    "prettier": "^3.3.3",
    "rollup": "^4.18.0",
    "rollup-plugin-copy": "^3.5.0",
    "servez": "^2.1.6",
    "tslib": "^2.6.3",
    "typescript": "^5.6.3"
  }
}
